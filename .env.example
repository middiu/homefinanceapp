# ---- Server ----
# Port the Express API (and bundled SPA) listens on
PORT=4000
# SQLite database file path (mounted volume in Docker)
DATABASE_URL=./data/homefinance.sqlite
# Public URL where the client can reach the API (used in dev; in prod the server
# serves the built client from the same origin, so this can be left as "/api")
VITE_API_URL=http://localhost:4000/api

# ---- AI provider (Ollama Cloud) ----
# Leave empty / AI_ENABLED=false to disable all AI features (no external calls).
AI_ENABLED=true
AI_BASE_URL=https://ollama.com/v1
AI_API_KEY=
AI_MODEL=llama3.1
# Schedule for the weekly AI digest (cron syntax). Default: every Monday 07:00.
AI_DIGEST_CRON=0 7 * * 1

# ---- Backups ----
# Local DB backup directory and daily cron time (server-side, in-process).
BACKUP_DIR=./backups
BACKUP_CRON=0 3 * * *
BACKUP_KEEP=14