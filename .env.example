# ---- Server ----
# Port the Express API (and bundled SPA) listens on
PORT=4000
# SQLite database file path (mounted volume in Docker)
DATABASE_URL=./data/homefinance.sqlite
# Public URL where the client can reach the API (used in dev; in prod the server
# serves the built client from the same origin, so this can be left as "/api")
VITE_API_URL=http://localhost:4000/api

# ---- AI provider ----
# Leave empty / AI_ENABLED=false to disable all AI features (no external calls).
# AI_PROVIDER: ollama (default) | grok | cursor
# AI_API_KEY is used only for AI_PROVIDER. It is not reused when you switch provider.
# Grok API keys are pinned to https://api.x.ai. A Grok subscription sign-in
# (AI & Insights) is pinned to https://cli-chat-proxy.grok.com and uses the
# subscription instead of AI_GROK_API_KEY. Cursor is pinned to https://api.cursor.com.
# Cursor account sign-in mints a user API key on the server. You can also paste a key.
AI_ENABLED=true
AI_PROVIDER=ollama
AI_BASE_URL=https://ollama.com/v1
AI_API_KEY=
AI_GROK_API_KEY=
AI_CURSOR_API_KEY=
AI_MODEL=
# Schedule for the weekly AI digest (cron syntax). Default: every Monday 07:00.
AI_DIGEST_CRON=0 7 * * 1

# ---- Backups ----
# Local DB backup directory and daily cron time (server-side, in-process).
BACKUP_DIR=./backups
BACKUP_CRON=0 3 * * *
BACKUP_KEEP=14

# ---- Authentication ----
# Initial admin password, seeded once on first boot. CHANGE IT on first login
# (you'll be forced to). After the first boot, editing this env var has NO effect —
# use the in-app Change Password page instead.
ADMIN_INITIAL_PASSWORD=Pa$$word!
# Session cookie lifetime in ms (default 7 days).
SESSION_TTL_MS=604800000
# Brute-force protection: max failed attempts before account lockout, and the
# base lockout duration (grows with repeated failures, capped at 30min).
AUTH_MAX_FAILS=5
AUTH_LOCKOUT_MS=300000
# Set the session cookie Secure flag (true when served over HTTPS; default true in
# production per NODE_ENV). Set false ONLY for plain-HTTP local testing.
COOKIE_SECURE=true
# Comma-separated list of allowed cross-origin hosts (for a split frontend).
# Leave empty to deny cross-origin (same-origin SPA is unaffected).
CORS_ORIGIN=